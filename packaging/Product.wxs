<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Iro" Manufacturer="Roland Matuz" Version="$(var.ProductVersion)" Language="1033"
           UpgradeCode="B93A2438-38BB-4D10-A79D-90B04CDDF219" Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Iro is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AppIcon" SourceFile="src\iro\assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Iro" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="Iro">
        <Component Id="StartMenuShortcut" Guid="1E74AB40-A984-4960-9666-168AFF93DDE9">
          <Shortcut Id="StartMenuLink" Name="Iro" Description="Your Fujifilm recipe library"
                    Target="[INSTALLFOLDER]Iro.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
          <RemoveFolder Id="RemoveAppMenu" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\FujiADB\Installer" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="MainFeature" Title="Iro" Level="1">
      <ComponentGroupRef Id="Payload" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="packaging\Notice.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="packaging\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="packaging\dialog.bmp" />
  </Package>
</Wix>
